# Fraud & Risk Service Environment Configuration
PORT=8006
NODE_ENV=development

# Dedicated PostgreSQL Schema for Fraud Analysis
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=fraud_schema"

# Kafka Event Streaming
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="fraud-service"
KAFKA_CONSUMER_GROUP="fraud-service-group"

# Configurable Fraud Rule Thresholds
HIGH_AMOUNT_THRESHOLD_PAISE=20000000 # ₹2,00,000.00
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_TRANSACTIONS=3
