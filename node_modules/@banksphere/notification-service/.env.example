# Notification Service Environment Configuration
PORT=8005
NODE_ENV=development

# Dedicated PostgreSQL Schema for Notifications
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=notification_schema"

# Kafka Event Streaming
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="notification-service"
KAFKA_CONSUMER_GROUP="notification-service-group"

# Dead-Letter Topic
KAFKA_DLQ_TOPIC="notifications.dlq"
MAX_NOTIFICATION_RETRIES=3
