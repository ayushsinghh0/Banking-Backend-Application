# ==========================================
# BankSphere production configuration (docker compose)
# cp .env.example .env and replace EVERY CHANGE_ME. Never commit the real .env.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (hex keeps passwords safe inside connection URLs)
# ==========================================

# PostgreSQL superuser (used only for initialisation) and one role per service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=banksphere
AUTH_DB_PASSWORD=CHANGE_ME
CUSTOMER_DB_PASSWORD=CHANGE_ME
ACCOUNT_DB_PASSWORD=CHANGE_ME
LEDGER_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
FRAUD_DB_PASSWORD=CHANGE_ME

# Redis (token revocation state, lockouts, rate limits)
REDIS_PASSWORD=CHANGE_ME

# Shared secrets (identical for every service, >= 32 chars)
JWT_ACCESS_SECRET=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Frontend base URL used in email links (/verify-email#token=..., /reset-password#token=...)
APP_BASE_URL=https://app.example.com
# Browser origins allowed by the API gateway (comma-separated)
CORS_ORIGINS=https://app.example.com
# Number of trusted proxy hops in front of the gateway (e.g. 1 behind a load balancer)
GATEWAY_TRUST_PROXY=1

# Outbound email (SMTP). Port 587 + STARTTLS (required) or 465 with SMTP_SECURE=true
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="BankSphere <no-reply@example.com>"
SECURITY_ALERT_EMAIL=security-team@example.com
