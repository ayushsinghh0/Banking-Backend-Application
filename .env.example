# ==========================================
# BankSphere Environment Variables Template (docker compose)
# Copy to .env and replace every CHANGE_ME value. Never commit the real .env.
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
POSTGRES_DB=banksphere

# Shared secrets (generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_value_of_at_least_32_chars
INTERNAL_SERVICE_TOKEN=CHANGE_ME_generate_a_different_random_value_of_at_least_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Browser origins allowed by the API gateway (comma-separated)
CORS_ORIGINS=http://localhost:3000
