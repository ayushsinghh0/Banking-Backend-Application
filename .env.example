# ==========================================
# BankSphere Environment Variables Template
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=banksphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Apache Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=banksphere-cluster

# JWT Secrets (Replace in production)
JWT_ACCESS_SECRET=banksphere_super_secret_access_jwt_key_2026_x99!
JWT_REFRESH_SECRET=banksphere_super_secret_refresh_jwt_key_2026_z88!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Microservice Ingress Ports
PORT_GATEWAY=8000
PORT_AUTH_SERVICE=8001
PORT_CUSTOMER_SERVICE=8002
PORT_ACCOUNT_SERVICE=8003
PORT_TRANSACTION_SERVICE=8004
PORT_NOTIFICATION_SERVICE=8005
PORT_FRAUD_SERVICE=8006
