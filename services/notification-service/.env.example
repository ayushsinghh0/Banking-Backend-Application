# Notification Service Environment Configuration
PORT=8005
NODE_ENV=development

# Dedicated PostgreSQL Schema for Notifications
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=notification_schema"

KAFKA_CONSUMER_GROUP="notification-service-group"
# Dead-Letter Topic
KAFKA_DLQ_TOPIC="notifications.dlq"
MAX_NOTIFICATION_RETRIES=3
SECURITY_ALERT_EMAIL="security-team@banksphere.com"

# Shared secrets: every service must use the SAME values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Services refuse to start if these are missing or shorter than 32 characters.
JWT_ACCESS_SECRET="CHANGE_ME_generate_a_random_value_of_at_least_32_chars"

# Kafka Event Backbone (set KAFKA_ENABLED=false to run without a broker; events are then not published)
KAFKA_ENABLED=true
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="notification-service"
