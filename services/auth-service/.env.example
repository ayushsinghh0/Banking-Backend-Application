# Auth Service Environment Variables
PORT=8001
NODE_ENV=development

# Dedicated PostgreSQL Schema for Auth Service
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=auth_schema"

# Redis (login / refresh rate limiting)
REDIS_URL="redis://localhost:6379"
AUTH_RATE_LIMIT_MAX=20

# Shared secrets: every service must use the SAME values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Services refuse to start if these are missing or shorter than 32 characters.
JWT_ACCESS_SECRET="CHANGE_ME_generate_a_random_value_of_at_least_32_chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION_DAYS=7

# Kafka Event Backbone (set KAFKA_ENABLED=false to run without a broker; events are then not published)
KAFKA_ENABLED=true
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="auth-service"
