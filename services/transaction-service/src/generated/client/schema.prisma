datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Authoritative local account representation within the ledger service boundary
model LedgerAccount {
  id            String        @id @default(uuid())
  accountNumber String        @unique @map("account_number")
  customerId    String        @map("customer_id")
  currency      String        @default("INR")
  balance       BigInt        @default(0) // Stored in minor units (e.g. Paise: 10000 = ₹100.00)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  entries       LedgerEntry[]

  @@map("ledger_accounts")
}

// Financial transactions metadata
model Transaction {
  id                   String            @id @default(uuid())
  referenceId          String            @unique @map("reference_id") // Business reference (e.g., TXN-2026-XXXX)
  type                 TransactionType
  status               TransactionStatus @default(PENDING)
  amount               BigInt // Amount in minor units (paise)
  currency             String            @default("INR")
  sourceAccountId      String?           @map("source_account_id")
  destinationAccountId String?           @map("destination_account_id")
  description          String?
  failureReason        String?           @map("failure_reason")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  entries              LedgerEntry[]

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdAt])
  @@map("transactions")
}

// Immutable, append-only double-entry ledger entries
model LedgerEntry {
  id            String    @id @default(uuid())
  transactionId String    @map("transaction_id")
  accountId     String    @map("account_id")
  entryType     EntryType @map("entry_type")
  amount        BigInt // Positive minor units (paise)
  currency      String    @default("INR")
  balanceAfter  BigInt    @map("balance_after") // Running balance snapshot
  createdAt     DateTime  @default(now()) @map("created_at")

  transaction Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

// Idempotency records for financial write safety
model IdempotencyRecord {
  id           String            @id @default(uuid())
  key          String            @unique
  endpoint     String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(PROCESSING)
  statusCode   Int?              @map("status_code")
  responseBody Json?             @map("response_body")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  expiresAt    DateTime          @map("expires_at")

  @@index([key, status])
  @@map("idempotency_records")
}

// Transactional Outbox for reliable Kafka event publishing
model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type") // e.g. "TRANSACTION"
  aggregateId   String       @map("aggregate_id") // e.g. transaction.id
  eventType     String       @map("event_type") // e.g. "transaction.completed.v1"
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")
  publishedAt   DateTime?    @map("published_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}
