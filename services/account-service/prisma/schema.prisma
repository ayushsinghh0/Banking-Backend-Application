datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum AccountType {
  SAVINGS
  CURRENT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

model BankAccount {
  id            String        @id @default(uuid())
  accountNumber String        @unique @map("account_number")
  customerId    String        @map("customer_id")
  accountType   AccountType   @default(SAVINGS) @map("account_type")
  status        AccountStatus @default(ACTIVE)
  currency      String        @default("INR")
  dailyLimit    BigInt        @default(10000000) @map("daily_limit") // In paise: default ₹1,00,000.00
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([accountNumber])
  @@map("bank_accounts")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// Transactional outbox: account events are written atomically with the account change
model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error")
  nextAttemptAt DateTime?    @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  publishedAt   DateTime?    @map("published_at")

  @@index([status, nextAttemptAt, createdAt])
  @@map("outbox_events")
}
