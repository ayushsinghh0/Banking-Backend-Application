# Account Service Environment Configuration
PORT=8003
NODE_ENV=development

# Dedicated PostgreSQL Schema for Bank Accounts
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=account_schema"

# Kafka Event Backbone
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="account-service"

# Ledger Service URL for balance lookups
LEDGER_SERVICE_URL="http://localhost:8004"
