# Account Service Environment Configuration
PORT=8003
NODE_ENV=development

# Dedicated PostgreSQL Schema for Bank Accounts
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=account_schema"

# Ledger (transaction-service) internal API, used to provision ledger accounts and propagate freezes
LEDGER_SERVICE_URL="http://localhost:8004"
MAX_CUSTOMER_DAILY_LIMIT_PAISE=10000000
MAX_ACCOUNTS_PER_CUSTOMER=5

# Shared secrets: every service must use the SAME values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Services refuse to start if these are missing or shorter than 32 characters.
JWT_ACCESS_SECRET="CHANGE_ME_generate_a_random_value_of_at_least_32_chars"
INTERNAL_SERVICE_TOKEN="CHANGE_ME_generate_a_random_value_of_at_least_32_chars"

# Kafka Event Backbone (set KAFKA_ENABLED=false to run without a broker; events are then not published)
KAFKA_ENABLED=true
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="account-service"
