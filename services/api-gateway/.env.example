# API Gateway - the only service that should be reachable from outside the cluster
PORT=8000
NODE_ENV=development
REDIS_URL="redis://localhost:6379"

# Comma-separated browser origins allowed to call the API (empty = no cross-origin browser access)
CORS_ORIGINS="http://localhost:3000"
# Set to the number of trusted reverse-proxy hops in front of the gateway (e.g. 1 behind a load balancer)
TRUST_PROXY=""
GATEWAY_RATE_LIMIT_PER_MINUTE=300

AUTH_SERVICE_URL="http://localhost:8001"
CUSTOMER_SERVICE_URL="http://localhost:8002"
ACCOUNT_SERVICE_URL="http://localhost:8003"
TRANSACTION_SERVICE_URL="http://localhost:8004"
NOTIFICATION_SERVICE_URL="http://localhost:8005"
FRAUD_SERVICE_URL="http://localhost:8006"
