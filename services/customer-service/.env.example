# Customer Service Environment Configuration
PORT=8002
NODE_ENV=development

# Dedicated PostgreSQL Schema for Customer Profiles
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=customer_schema"

# Redis Cache
REDIS_URL="redis://localhost:6379"
PROFILE_CACHE_TTL_SECONDS=1800

# Shared secrets: every service must use the SAME values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Services refuse to start if these are missing or shorter than 32 characters.
JWT_ACCESS_SECRET="CHANGE_ME_generate_a_random_value_of_at_least_32_chars"
