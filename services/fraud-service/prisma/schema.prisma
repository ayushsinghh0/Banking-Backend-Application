datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// Consumer idempotency guard
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([eventId])
  @@map("processed_events")
}

// Risk evaluations recorded for transactions
model RiskAssessment {
  id             String    @id @default(uuid())
  transactionId  String    @map("transaction_id")
  accountId      String    @map("account_id")
  amountInPaise  BigInt    @map("amount_in_paise")
  riskScore      Int       @map("risk_score") // 0 to 100
  riskLevel      RiskLevel @default(LOW) @map("risk_level")
  triggeredRules Json      @map("triggered_rules") // Array of rule IDs that fired
  assessedAt     DateTime  @default(now()) @map("assessed_at")

  @@index([transactionId])
  @@index([accountId])
  @@index([riskLevel])
  @@map("risk_assessments")
}

// High or Critical severity alerts raised for fraud analyst review
model FraudAlert {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  accountId     String      @map("account_id")
  severity      RiskLevel   @default(HIGH)
  reason        String
  status        AlertStatus @default(OPEN)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([transactionId])
  @@map("fraud_alerts")
}
