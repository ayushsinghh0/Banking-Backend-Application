# Fraud & Risk Service Environment Configuration
PORT=8006
NODE_ENV=development

# Dedicated PostgreSQL Schema for Fraud Analysis
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banksphere?schema=fraud_schema"
KAFKA_CONSUMER_GROUP="fraud-service-group"

# Configurable Fraud Rule Thresholds
HIGH_AMOUNT_THRESHOLD_PAISE=20000000
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_TRANSACTIONS=3

# Shared secrets: every service must use the SAME values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Services refuse to start if these are missing or shorter than 32 characters.
JWT_ACCESS_SECRET="CHANGE_ME_generate_a_random_value_of_at_least_32_chars"

# Kafka Event Backbone (set KAFKA_ENABLED=false to run without a broker; events are then not published)
KAFKA_ENABLED=true
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="fraud-service"
